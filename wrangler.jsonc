// Cloudflare Workers 静态资源部署配置。
// 构建命令 pnpm build 生成 dist/，部署命令 npx wrangler deploy 上传 dist/。
// 有了这个文件，wrangler 就不会进入自动配置、往项目里安装 wrangler 依赖。
{
  "name": "learn-math",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    // 找不到页面时返回 dist/404.html
    "not_found_handling": "404-page"
  },
  // 在 Cloudflare 控制台查看请求日志和指标
  "observability": {
    "enabled": true
  }
}
